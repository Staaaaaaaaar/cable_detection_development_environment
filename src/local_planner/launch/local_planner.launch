<launch>

  <arg name="sensorOffsetX" default="0.0"/>
  <arg name="sensorOffsetY" default="0.0"/>
  <arg name="cameraOffsetZ" default="0.0"/>
  <!-- Operational speed ceiling for navigation (below hardware max) -->
  <arg name="maxSpeed" default="1.0"/>
  <arg name="autonomyMode" default="true"/>
  <arg name="autonomySpeed" default="1.0"/>
  <arg name="joyToSpeedDelay" default="2.0"/>
  <arg name="goalPosThre" default="0.20"/>
  <arg name="goalYawThre" default="10.0"/>

  <node pkg="local_planner" exec="localPlanner" name="localPlanner" output="screen">
    <!-- Body box: 700mm x 400mm x 450mm -->
    <param name="vehicleLength" value="0.7" />
    <param name="vehicleWidth" value="0.4" />
    <param name="sensorOffsetX" value="$(var sensorOffsetX)" />
    <param name="sensorOffsetY" value="$(var sensorOffsetY)" />
    <param name="laserVoxelSize" value="0.05" />
    <param name="terrainVoxelSize" value="0.2" />
    <param name="useTerrainAnalysis" value="true" />
    <param name="checkObstacle" value="true" />
    <param name="checkRotObstacle" value="true" />
    <param name="adjacentRange" value="2.5" />
    <param name="obstacleHeightThre" value="0.15" />
    <param name="groundHeightThre" value="0.1" />
    <param name="pointPerPathThre" value="2" />
    <param name="minRelZ" value="-0.5" />
    <param name="maxRelZ" value="0.25" />
    <param name="maxSpeed" value="$(var maxSpeed)" />
    <!-- Holonomic trajectory rollout: translation direction is independent of yaw. -->
    <param name="safetyMargin" value="0.10" />
    <param name="pathResolution" value="0.10" />
    <param name="candidateAngleStep" value="5.0" />
    <param name="minCandidateLength" value="0.30" />
    <param name="minPathRange" value="0.5" />
    <param name="pathRangeBySpeed" value="true" />
    <param name="goalPositionTolerance" value="$(var goalPosThre)" />
    <param name="goalYawTolerance" value="$(var goalYawThre)" />
    <param name="goalWeight" value="4.0" />
    <param name="headingWeight" value="0.8" />
    <param name="lengthWeight" value="1.5" />
    <param name="terrainCostWeight" value="1.0" />
    <param name="directionChangeWeight" value="0.25" />
    <!-- Candidate travel time uses the anisotropic quadruped velocity envelope. -->
    <param name="traversalTimeWeight" value="0.4" />
    <param name="maxForwardVelocity" value="3.0" />
    <param name="maxLateralVelocity" value="1.0" />
    <param name="autonomyMode" value="$(var autonomyMode)" />
    <param name="autonomySpeed" value="$(var autonomySpeed)" />
    <param name="joyToSpeedDelay" value="$(var joyToSpeedDelay)" />
    <param name="joyToCheckObstacleDelay" value="5.0" />
  </node>

  <node pkg="local_planner" exec="pathFollower" name="pathFollower" output="screen">
    <param name="sensorOffsetX" value="$(var sensorOffsetX)" />
    <param name="sensorOffsetY" value="$(var sensorOffsetY)" />
    <param name="pubSkipNum" value="1" />
    <param name="lookAheadDis" value="0.25" />
    <param name="posGain" value="4.0" />
    <param name="yawGain" value="2.0" />
    <param name="pathYawGain" value="3.0" />
    <!-- Hardware velocity limits (rad/s for yaw) -->
    <param name="maxVx" value="3.0" />
    <param name="minVx" value="0.05" />
    <param name="maxVy" value="1.0" />
    <param name="minVy" value="0.1" />
    <param name="maxYawRate" value="3.0" />
    <param name="minYawRate" value="0.02" />
    <param name="maxSpeed" value="$(var maxSpeed)" />
    <param name="maxLateralSpeed" value="1.0" />
    <param name="maxAccel" value="1.0" />
    <param name="maxYawAccel" value="3.0" />
    <!-- Zero one translation axis instead of snapping it when its pose error is negligible. -->
    <param name="axisStopPosThre" value="0.03" />
    <param name="slowDwnDisThre" value="1.0" />
    <param name="poseServoDisThre" value="1.5" />
    <param name="goalPosThre" value="$(var goalPosThre)" />
    <param name="goalYawThre" value="$(var goalYawThre)" />
    <param name="useInclRateToSlow" value="false" />
    <param name="inclRateThre" value="120.0" />
    <param name="slowRate1" value="0.25" />
    <param name="slowRate2" value="0.5" />
    <param name="slowTime1" value="2.0" />
    <param name="slowTime2" value="2.0" />
    <param name="useInclToStop" value="false" />
    <param name="inclThre" value="45.0" />
    <param name="stopTime" value="5.0" />
    <param name="autonomyMode" value="$(var autonomyMode)" />
    <param name="autonomySpeed" value="$(var autonomySpeed)" />
    <param name="joyToSpeedDelay" value="$(var joyToSpeedDelay)" />
  </node>

  <node pkg="tf2_ros" exec="static_transform_publisher" name="vehicleTransPublisher" args="-$(var sensorOffsetX) -$(var sensorOffsetY) 0 0 0 0 /sensor /vehicle"/>

  <node pkg="tf2_ros" exec="static_transform_publisher" name="sensorTransPublisher" args="0 0 $(var cameraOffsetZ) -1.5707963 0 -1.5707963 /sensor /camera"/>

</launch>
